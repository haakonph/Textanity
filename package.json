{
  "name": "textanity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24 <25", "npm": ">=11 <12" },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "nx run-many -t dev --projects=web,api --parallel=2",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:integration": "nx run api:integration",
    "start": "node --env-file-if-exists=.env dist/apps/api/main.js",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "nx run database:migrate",
    "db:rollback": "nx run database:rollback",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "nx": "24.0.6"
  }
}
