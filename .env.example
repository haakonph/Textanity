# Local development only. Use managed secrets and a dedicated database in production.
DATABASE_URL=postgresql://textanity:textanity@127.0.0.1:5432/textanity
HOST=127.0.0.1
PORT=3000
# Used by Vite's development proxy; keep /api on the same origin in production.
API_PROXY_TARGET=http://127.0.0.1:3000
# Required for editor reads/writes. Generate with: openssl rand -hex 32
# Keep this secret; the shared key grants editor and approval access.
EDITOR_API_TOKEN=
