{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "dev": { "executor": "nx:run-commands", "continuous": true, "options": { "command": "vite --config apps/web/vite.config.js" } },
    "build": { "executor": "nx:run-commands", "outputs": ["{workspaceRoot}/dist/apps/web"], "options": { "command": "vite build --config apps/web/vite.config.js" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "eslint apps/web" } }
  }
}
